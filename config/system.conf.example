# Monk_SKUD_UNEX configuration
server.port=8080
serial.enabled=true
serial.device=auto
serial.baudrate=9600
controllers.scan_from=1
controllers.scan_to=16
controllers.poll_interval_ms=200
cards.auto_create_unknown=false
attendance.accidental_repeat_seconds=5
time_sync.enabled=true
time_sync.interval_minutes=60
time_sync.retry_seconds=60
telegram.enabled=false
telegram.bot_token=
telegram.chat_id=
telegram.notify_arrival=true
telegram.notify_departure=true
telegram.notify_recent_minutes=10
telegram.report_text_copy=true
telegram.retry_count=3
reports.schedule.enabled=false
reports.schedule.period=daily
reports.schedule.time=18:00
reports.schedule.weekday=1
reports.schedule.month_day=1
auth.username=admin
# auth.salt and auth.password_hash are generated at first start

# MariaDB primary runtime storage. Run scripts/setup_mariadb.sh first, then restart.
database.enabled=false
database.host=127.0.0.1
database.port=3306
database.name=monk_skud_unex
database.user=monk_skud
database.password=
database.auto_create=true
database.migrate_users_csv=true
database.migrate_runtime_csv=true
database.remove_csv_after_migration=true
